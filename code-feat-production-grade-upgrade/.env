# --- Docker Compose Environment Variables ---
# These variables are used by the services defined in docker-compose.yml

# PostgreSQL service variables
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=crypto_data

# --- Application Environment Variables ---

# DSN for connecting to the database.
# Choose the appropriate DSN based on your execution environment.

# Option 1: For running with Docker Compose.
# The hostname 'db' refers to the database service name in docker-compose.yml.
DB_DSN=postgresql://user:password@db:5432/crypto_data

# Option 2: For running the Streamlit app locally on your host machine.
# Use 'localhost' as the hostname to connect to the database also running on your host.
# DB_DSN=postgresql://user:password@localhost:5432/crypto_data
