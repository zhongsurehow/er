# --- Application Environment Variables ---

# --- Database Configuration ---
# The application now uses SQLite. This variable defines the path to the database file.
# It can be a relative or absolute path.
SQLITE_DB_PATH=data/crypto_data.db

# --- Configuration File Path ---
# (Optional) Uncomment and set this to override the default 'config' directory path.
# CONFIG_PATH=path/to/your/config/folder

# --- RPC URLs for DEX Providers ---
# (Optional) Provide your own RPC URLs for better performance and reliability.
# RPC_URL_ETHEREUM=https://eth.llamarpc.com

# --- API Keys for CEX Providers ---
# (Optional) Add your API keys here to enable fetching more detailed data (e.g., transfer fees).
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
